IMPORT "@std/text/text.bas"

EXPORT RECORD Log_Field(key, value)
EXPORT RECORD Log_Event(timestamp_milliseconds, level, logger, body_text, fields)

FUNCTION escape_text(value)
    VAR escaped = text.replace(value, "\\", "\\\\")
    escaped = text.replace(escaped, "\n", "\\n")
    escaped = text.replace(escaped, "\r", "\\r")
    escaped = text.replace(escaped, "\t", "\\t")
    escaped = text.replace(escaped, "\u{1}", "\\u{0001}")
    escaped = text.replace(escaped, "\u{2}", "\\u{0002}")
    escaped = text.replace(escaped, "\u{3}", "\\u{0003}")
    escaped = text.replace(escaped, "\u{4}", "\\u{0004}")
    escaped = text.replace(escaped, "\u{5}", "\\u{0005}")
    escaped = text.replace(escaped, "\u{6}", "\\u{0006}")
    escaped = text.replace(escaped, "\u{7}", "\\u{0007}")
    escaped = text.replace(escaped, "\u{8}", "\\u{0008}")
    escaped = text.replace(escaped, "\u{b}", "\\u{000b}")
    escaped = text.replace(escaped, "\u{c}", "\\u{000c}")
    escaped = text.replace(escaped, "\u{e}", "\\u{000e}")
    escaped = text.replace(escaped, "\u{f}", "\\u{000f}")
    escaped = text.replace(escaped, "\u{10}", "\\u{0010}")
    escaped = text.replace(escaped, "\u{11}", "\\u{0011}")
    escaped = text.replace(escaped, "\u{12}", "\\u{0012}")
    escaped = text.replace(escaped, "\u{13}", "\\u{0013}")
    escaped = text.replace(escaped, "\u{14}", "\\u{0014}")
    escaped = text.replace(escaped, "\u{15}", "\\u{0015}")
    escaped = text.replace(escaped, "\u{16}", "\\u{0016}")
    escaped = text.replace(escaped, "\u{17}", "\\u{0017}")
    escaped = text.replace(escaped, "\u{18}", "\\u{0018}")
    escaped = text.replace(escaped, "\u{19}", "\\u{0019}")
    escaped = text.replace(escaped, "\u{1a}", "\\u{001a}")
    escaped = text.replace(escaped, "\u{1b}", "\\u{001b}")
    escaped = text.replace(escaped, "\u{1c}", "\\u{001c}")
    escaped = text.replace(escaped, "\u{1d}", "\\u{001d}")
    escaped = text.replace(escaped, "\u{1e}", "\\u{001e}")
    escaped = text.replace(escaped, "\u{1f}", "\\u{001f}")
    escaped = text.replace(escaped, "\u{7f}", "\\u{007f}")
    escaped = text.replace(escaped, "\u{80}", "\\u{0080}")
    escaped = text.replace(escaped, "\u{81}", "\\u{0081}")
    escaped = text.replace(escaped, "\u{82}", "\\u{0082}")
    escaped = text.replace(escaped, "\u{83}", "\\u{0083}")
    escaped = text.replace(escaped, "\u{84}", "\\u{0084}")
    escaped = text.replace(escaped, "\u{85}", "\\u{0085}")
    escaped = text.replace(escaped, "\u{86}", "\\u{0086}")
    escaped = text.replace(escaped, "\u{87}", "\\u{0087}")
    escaped = text.replace(escaped, "\u{88}", "\\u{0088}")
    escaped = text.replace(escaped, "\u{89}", "\\u{0089}")
    escaped = text.replace(escaped, "\u{8a}", "\\u{008a}")
    escaped = text.replace(escaped, "\u{8b}", "\\u{008b}")
    escaped = text.replace(escaped, "\u{8c}", "\\u{008c}")
    escaped = text.replace(escaped, "\u{8d}", "\\u{008d}")
    escaped = text.replace(escaped, "\u{8e}", "\\u{008e}")
