    escaped = text.replace(escaped, "\u{93}", "\\u{0093}")
    escaped = text.replace(escaped, "\u{94}", "\\u{0094}")
    escaped = text.replace(escaped, "\u{95}", "\\u{0095}")
    escaped = text.replace(escaped, "\u{96}", "\\u{0096}")
    escaped = text.replace(escaped, "\u{97}", "\\u{0097}")
    escaped = text.replace(escaped, "\u{98}", "\\u{0098}")
    escaped = text.replace(escaped, "\u{99}", "\\u{0099}")
    escaped = text.replace(escaped, "\u{9a}", "\\u{009a}")
    escaped = text.replace(escaped, "\u{9b}", "\\u{009b}")
    escaped = text.replace(escaped, "\u{9c}", "\\u{009c}")
    escaped = text.replace(escaped, "\u{9d}", "\\u{009d}")
    escaped = text.replace(escaped, "\u{9e}", "\\u{009e}")
    escaped = text.replace(escaped, "\u{9f}", "\\u{009f}")
    RETURN escaped
END FUNCTION

' Deterministic single-line representation; timestamps and field order are caller supplied.
EXPORT FUNCTION format_text(entry)
    VAR output = $"{entry.timestamp_milliseconds}|{entry.level}|{escape_text(entry.logger)}|{escape_text(entry.body_text)}"
    FOR field IN entry.fields
        output = output + $"|{escape_text(field.key)}={escape_text(field.value)}"
    END FOR
    RETURN output + "\n"
END FUNCTION
