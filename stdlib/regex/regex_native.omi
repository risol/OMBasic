NATIVE "ombasic_runtime"
FUNCTION regex_find_result(pattern: CString BORROWED, input: CString BORROWED): CString
    SYMBOL "om_runtime_regex_find"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_value
END FUNCTION

FUNCTION release_value(value: CPointer OWNED): CVoid
    SYMBOL "om_runtime_regex_release"
    EFFECT PURE
    NONBLOCKING
END FUNCTION
END NATIVE
