NATIVE "ombasic_runtime"
FUNCTION native_os_name(): CString
    SYMBOL "om_runtime_platform_os_name"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_string
END FUNCTION

FUNCTION native_architecture(): CString
    SYMBOL "om_runtime_platform_architecture"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_string
END FUNCTION

FUNCTION native_target_triple(): CString
    SYMBOL "om_runtime_platform_target_triple"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_string
END FUNCTION

FUNCTION native_path_separator(): CString
    SYMBOL "om_runtime_platform_path_separator"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_string
END FUNCTION

FUNCTION native_line_separator(): CString
    SYMBOL "om_runtime_platform_line_separator"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_string
END FUNCTION

FUNCTION release_string(value: CPointer OWNED): CVoid
    SYMBOL "om_runtime_platform_release"
    EFFECT PURE
    NONBLOCKING
END FUNCTION
END NATIVE
