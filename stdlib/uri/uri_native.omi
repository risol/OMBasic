NATIVE "ombasic_runtime"
FUNCTION ascii_status(value: CUtf8Slice BORROWED): CInt64
    SYMBOL "om_runtime_uri_ascii_status"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION ascii_offset(value: CUtf8Slice BORROWED): CInt64
    SYMBOL "om_runtime_uri_ascii_offset"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION percent_syntax_status(value: CUtf8Slice BORROWED): CInt64
    SYMBOL "om_runtime_uri_percent_syntax_status"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION percent_syntax_offset(value: CUtf8Slice BORROWED): CInt64
    SYMBOL "om_runtime_uri_percent_syntax_offset"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION percent_encode_status(value: CUtf8Slice BORROWED, component: CInt64): CInt64
    SYMBOL "om_runtime_uri_percent_encode_status"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION native_percent_encode(value: CUtf8Slice BORROWED, component: CInt64): CString
    SYMBOL "om_runtime_uri_percent_encode"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_string
END FUNCTION

FUNCTION native_remove_dot_segments(value: CUtf8Slice BORROWED): CString
    SYMBOL "om_runtime_uri_remove_dot_segments"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_string
END FUNCTION

FUNCTION percent_decode_status(value: CUtf8Slice BORROWED): CInt64
    SYMBOL "om_runtime_uri_percent_decode_status"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION percent_decode_offset(value: CUtf8Slice BORROWED): CInt64
    SYMBOL "om_runtime_uri_percent_decode_offset"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION native_percent_decode(value: CUtf8Slice BORROWED): CUtf8Slice
    SYMBOL "om_runtime_uri_percent_decode"
    EFFECT PURE
    NONBLOCKING
    RETURNS OWNED WITH release_slice
END FUNCTION

FUNCTION release_string(value: CPointer OWNED): CVoid
    SYMBOL "om_runtime_uri_percent_release"
    EFFECT PURE
    NONBLOCKING
END FUNCTION

FUNCTION release_slice(value: CPointer OWNED): CVoid
    SYMBOL "om_runtime_uri_slice_release"
    EFFECT PURE
    NONBLOCKING
END FUNCTION
END NATIVE
